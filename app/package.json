{
  "name": "365movies",
  "version": "2.6.2",
  "description": "Search, track and get notified about movies release dates",
  "productName": "Movies365 App",
  "author": "Marcelo Munhoz <me@marcelomunhoz.com>",
  "private": true,
  "scripts": {
    "test": "yarn test:unit:ci && yarn test:e2e:ci",
    "dev": "concurrently \"quasar dev\" \"node src/middleware/server.js\"",
    "backend": "node src/middleware/server.js",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare",
    "test:unit:ui": "vitest --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:e2e": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress start-test \"quasar dev\" http-get://127.0.0.1:3650 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress start-test \"quasar dev\" http-get://127.0.0.1:3650 \"cypress run --e2e\"",
    "test:component": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --component",
    "cypress:install": "cross-env CYPRESS_CACHE_FOLDER=.cache/Cypress cypress install"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.11",
    "@netlify/functions": "^5.3.0",
    "@popperjs/core": "^2.11.8",
    "@quasar/extras": "^1.18.0",
    "accessibility": "^6.1.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "pinia": "^3.0.4",
    "quasar": "^2.35.6",
    "serverless-http": "^3.2.0",
    "v-calendar": "^3.0.3",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@quasar/app-vite": "3.10.4",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "7.0.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^3.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/ui": "4.1.12",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.7",
    "cross-env": "^7.0.3",
    "cypress": "^15.21.2",
    "dotenv": "^16.6.1",
    "eslint-plugin-cypress": "^3.6.0",
    "postcss": "^8.5.28",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^3.4.19",
    "vite": "8.3.8",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "4.1.12"
  },
  "resolutions": {
    "@fastify/busboy": "^3.2.2",
    "axios/follow-redirects": "^1.16.2",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser": "^1.20.9",
    "braces": "^3.0.3",
    "browserslist": "^4.28.9",
    "cypress/systeminformation": "^5.33.16",
    "express/proxy-addr": "~2.0.8",
    "fast-uri": "^3.1.9",
    "glob": "^14.0.2",
    "immutable": "^5.1.8",
    "joi": "^18.3.1",
    "js-yaml": "^4.3.2",
    "micromatch": "^4.0.8",
    "minimatch": "^11.0.1",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^6.1.5",
    "qs": "~6.16.1",
    "serialize-javascript": "^7.1.3",
    "source-map-js": "^1.2.2",
    "uuid": "11.1.1",
    "vite": "8.3.8",
    "workbox-build/glob/minimatch/brace-expansion": "^5.0.12"
  },
  "engines": {
    "node": "^22.22.0",
    "npm": "please-use-yarn",
    "yarn": ">= 1.22.22"
  }
}
