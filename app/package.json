{
  "name": "365movies",
  "version": "2.6.2",
  "description": "Search, track and get notified about movies release dates",
  "productName": "Movies365 App",
  "author": "Marcelo Munhoz <me@marcelomunhoz.com>",
  "private": true,
  "scripts": {
    "test": "yarn test:unit:ci && yarn test:e2e:ci",
    "dev": "concurrently \"quasar dev\" \"node src/middleware/server.js\"",
    "backend": "node src/middleware/server.js",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare",
    "test:unit:ui": "vitest --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:e2e": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress start-test \"quasar dev\" http-get://127.0.0.1:3650 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress start-test \"quasar dev\" http-get://127.0.0.1:3650 \"cypress run --e2e\"",
    "test:component": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --component",
    "cypress:install": "cross-env CYPRESS_CACHE_FOLDER=.cache/Cypress cypress install"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^5.3.0",
    "@popperjs/core": "^2.11.8",
    "@quasar/extras": "^1.18.0",
    "accessibility": "^6.1.0",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "pinia": "^2.3.1",
    "quasar": "^2.33.0",
    "register-service-worker": "^1.7.2",
    "serverless-http": "^3.2.0",
    "v-calendar": "^3.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@quasar/app-vite": "2.4.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "6.2.1",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "4.1.11",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "cypress": "^15.18.1",
    "dotenv": "^16.6.1",
    "eslint-plugin-cypress": "^3.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "workbox-build/glob/minimatch/brace-expansion": "^5.0.12",
    "@quasar/quasar-app-extension-testing-e2e-cypress/vite-plugin-istanbul/test-exclude/minimatch/brace-expansion": "^5.0.12",
    "body-parser": "^1.20.6",
    "micromatch": "^4.0.8",
    "serialize-javascript": "^7.0.7",
    "shell-quote": "^1.10.0",
    "esbuild": "^0.25.12",
    "vite": "7.3.6",
    "happy-dom": "^20.11.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.28",
    "fast-uri": "^3.1.8",
    "nanoid": "^3.3.19",
    "browserslist": "^4.28.9",
    "baseline-browser-mapping": "^2.11.0",
    "qs": "^6.16.0",
    "joi": "^18.2.5",
    "uuid": "11.1.1",
    "immutable": "^5.1.8"
  },
  "engines": {
    "node": "^22.22.0",
    "npm": "please-use-yarn",
    "yarn": ">= 1.22.22"
  }
}
